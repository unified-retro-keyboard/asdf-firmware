#include <stddef.h>
#include <stdbool.h>
#include <stdint.h>
#include "asdf_arch.h"
#include "asdf_keymaps.h"
#include "asdf_keymap_setup.h"

// Keymap descriptors, defined by the keymap modules.
@keymap_declarations@

/** Keymap registry slots: one past the highest keymap number. */
#define NUM_KEYMAP_SLOTS @keymap_slots@u

/**
 * Look up a keymap's descriptor in the registry.
 *
 * No side effects.
 *
 * @param index  Keymap number.
 * @return The keymap's descriptor, in flash; NULL if @p index is past the end
 *         of the registry or its slot is empty.
 *
 * The registry is a table in flash, indexed by keymap number, where unlisted
 * numbers are NULL. The entry is read out of flash with FLASH_READ_PTR.
 *
 * Complexity: 2
 */
const asdf_keymap_t *asdf_keymap_descriptor(uint8_t index) {
  static const asdf_keymap_t *const FLASH keymap_table[NUM_KEYMAP_SLOTS] = {@keymap_table@
  };

  return (index < NUM_KEYMAP_SLOTS)
           ? (const asdf_keymap_t *) FLASH_READ_PTR(&keymap_table[index])
           : NULL;
}

/**
 * Report whether a keymap exists.
 *
 * No side effects.
 *
 * @param index  Keymap number.
 * @return true if there is a keymap with that number; false otherwise.
 */
bool asdf_keymap_valid(uint8_t index) {
  return NULL != asdf_keymap_descriptor(index);
}
