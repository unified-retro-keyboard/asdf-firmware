#if !defined(ASDF_KEYMAP_SETUP_H)
#define ASDF_KEYMAP_SETUP_H

#include <stdbool.h>
#include <stdint.h>
#include "asdf_keymaps.h"

/**
 * Look up a keymap's descriptor.
 *
 * No side effects.
 *
 * @param index  Keymap number.
 * @return The keymap's descriptor, in flash; NULL if there is no keymap with
 *         that number.
 */
const asdf_keymap_t *asdf_keymap_descriptor(uint8_t index);

/**
 * Whether a keymap exists.
 *
 * No side effects.
 *
 * @param index  Keymap number.
 * @return true if there is a keymap with that number; false otherwise.
 */
bool asdf_keymap_valid(uint8_t index);

