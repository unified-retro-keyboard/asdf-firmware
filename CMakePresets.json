{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build-${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "test",
      "inherits": "base",
      "displayName": "test: Host unit tests",
      "cacheVariables": {
        "ARCH": "test"
      }
    },
    {
      "name": "atmega328p",
      "inherits": "base",
      "displayName": "atmega328p: AVR firmware",
      "cacheVariables": {
        "ARCH": "atmega328p"
      }
    },
    {
      "name": "atmega168p",
      "inherits": "base",
      "displayName": "atmega168p: AVR firmware",
      "cacheVariables": {
        "ARCH": "atmega168p"
      }
    },
    {
      "name": "atmega2560",
      "inherits": "base",
      "displayName": "atmega2560: AVR firmware",
      "cacheVariables": {
        "ARCH": "atmega2560"
      }
    },
    {
      "name": "atmega1280",
      "inherits": "base",
      "displayName": "atmega1280: AVR firmware",
      "cacheVariables": {
        "ARCH": "atmega1280"
      }
    },
    {
      "name": "atmega640",
      "inherits": "base",
      "displayName": "atmega640: AVR firmware",
      "cacheVariables": {
        "ARCH": "atmega640"
      }
    },
    {
      "name": "pic32cm_pl10_q64",
      "inherits": "base",
      "displayName": "pic32cm_pl10_q64: PIC32CM PL10 firmware (build-verified)",
      "cacheVariables": {
        "ARCH": "pic32cm_pl10_q64"
      }
    },
    {
      "name": "pic32cm_pl10_dip28",
      "inherits": "base",
      "displayName": "pic32cm_pl10_dip28: PIC32CM PL10 firmware (build-verified)",
      "cacheVariables": {
        "ARCH": "pic32cm_pl10_dip28"
      }
    },
    {
      "name": "simavr_test",
      "inherits": "base",
      "displayName": "simavr_test: simavr integration tests",
      "cacheVariables": {
        "ARCH": "simavr_test"
      }
    },
    {
      "name": "test-sanitize",
      "inherits": "base",
      "displayName": "Host unit tests under ASan and UBSan",
      "cacheVariables": {
        "ARCH": "test",
        "ASDF_SANITIZE": "ON"
      }
    },
    {
      "name": "test-coverage",
      "inherits": "base",
      "displayName": "Host unit tests with core coverage report",
      "cacheVariables": {
        "ARCH": "test",
        "ASDF_COVERAGE": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "test",
      "configurePreset": "test"
    },
    {
      "name": "atmega328p",
      "configurePreset": "atmega328p"
    },
